# =============================================================================
# ZuriDrive — environment variables
#
# Copy to .env.local and fill in. Every name below is actually read by the
# code. Re-verify after changes with:
#   grep -rhoE "process\.env\.[A-Z_0-9]+" app lib components middleware.ts | sort -u
# =============================================================================

# --- Database ----------------------------------------------------------------
# Local dev database via docker:
#   docker run -d --name zuridrive-db -e POSTGRES_PASSWORD=zuridrive \
#     -e POSTGRES_USER=zuridrive -e POSTGRES_DB=zuridrive \
#     -p 5433:5432 postgres:16-alpine
DATABASE_URL="postgresql://zuridrive:zuridrive@localhost:5433/zuridrive"

# --- NextAuth ----------------------------------------------------------------
# Read by NextAuth itself. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# --- OTP policy --------------------------------------------------------------
# Optional — values shown are the defaults the code falls back to.
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="3"
OTP_LOCKOUT_MINUTES="15"

# Where MTN calls back when a payment resolves. MUST be a public HTTPS URL —
# without it, payments are only ever confirmed by the customer's browser
# polling, so closing the tab leaves money taken and the booking unconfirmed.
# Defaults to NEXTAUTH_URL when that is https. Leave blank in local dev.
MTN_MOMO_CALLBACK_URL=""

# --- Payments ---------------------------------------------------------------
# Phase 1 launches with DIRECT: renters pay owners at handover and ZuriDrive
# takes no payments, so nothing here is needed. Leave it blank and the platform
# defaults to direct settlement.
#
# Phase 2 switches to FLUTTERWAVE (one contract covers MTN MoMo, Airtel and
# cards). Set all three, then flip canCollect in providers/flutterwave.ts.
PAYMENT_PROVIDER=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# --- SMS (Africa's Talking) --------------------------------------------------
# Use username "sandbox" for testing.
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID="ZuriDrive"

# --- Cloudinary --------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME is used server-side; the NEXT_PUBLIC_ copy is used by
# the browser upload widget. Both should hold the same value.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- MTN Mobile Money --------------------------------------------------------
MTN_MOMO_ENVIRONMENT="sandbox"
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_COLLECTION_PRIMARY_KEY=""

# --- Cron --------------------------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`.
# Every /api/cron/* route rejects requests that don't carry it.
CRON_SECRET=""

# =============================================================================
# NOTE: the platform commission rate is NOT an env var. It is a constant in
# lib/booking/pricing.ts (COMMISSION_RATE_PERCENT = 20) because it must be
# snapshotted onto every Booking and Commission row at creation time.
# Making it configurable is part of the Super Admin settings work (step 13).
# =============================================================================

# --- Error monitoring (Sentry) -----------------------------------------------
# Entirely optional. With both blank, Sentry is inert and nothing is sent —
# which is what you want locally and in CI.
# Create a project at sentry.io, then paste the same DSN into both.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Mirrors PAYMENT_PROVIDER for the browser. Copy-only: decides whether
# renters are told ZuriDrive holds their deposit, or the owner does.
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
